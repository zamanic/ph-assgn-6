# Auto-handle line endings across Windows / macOS / Linux
* text=auto eol=lf

# Explicit text files (force LF)
*.ts       text eol=lf
*.tsx      text eol=lf
*.js       text eol=lf
*.jsx      text eol=lf
*.mjs      text eol=lf
*.css      text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.svg      text eol=lf
.gitignore text eol=lf

# Binary assets (don't mess with line endings)
*.png  binary
*.ico  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
